# Image/build
CATHSIM_IMAGE=cathsim-server:local
CATHSIM_CUDA_IMAGE=nvidia/cuda:12.1.1-runtime-ubuntu22.04
CATHSIM_APT_MIRROR=https://repo.huaweicloud.com/ubuntu
CATHSIM_PIP_INDEX_URL=https://mirrors.huaweicloud.com/repository/pypi/simple
CATHSIM_UID=1000
CATHSIM_GID=1000

# API service
CATHSIM_PORT=9000
# `compose.runtime.yaml` host port; container port remains 9000.
CATHSIM_HOST_PORT=19000
# `compose.simulation.yaml` host port for the image without RL frameworks.
CATHSIM_SIMULATION_HOST_PORT=19001
CATHSIM_PHYSICS_ENGINE=newton
CUDA_VISIBLE_DEVICES=0
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics

# Validated Newton defaults
CATHSIM_NEWTON_SUBSTEPS=6
CATHSIM_NEWTON_ITERS=2
CATHSIM_NEWTON_PUSH_SPEED=0.05

# Optional `cathsim-train` profile
CATHSIM_RL_ALGORITHM=ppo
CATHSIM_RUN_NAME=stage0_endpoint_0
CATHSIM_PHANTOM=aorta_tree
CATHSIM_ROUTE_TARGET=endpoint_0
CATHSIM_ACTION_MODE=shape_intent
CATHSIM_TOTAL_TIMESTEPS=100000
CATHSIM_SEED=0
CATHSIM_EVAL_EPISODES=5
