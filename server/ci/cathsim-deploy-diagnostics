#!/usr/bin/env bash
set -u

echo "=== timestamp ==="
date --iso-8601=seconds
echo "=== state ==="
for path in /var/lib/cathsim-deploy/current-image \
            /var/lib/cathsim-deploy/previous-image \
            /var/lib/cathsim-deploy/current-commit \
            /var/lib/cathsim-deploy/last-run-id; do
  if [[ -f "$path" ]]; then
    printf '%s=' "$(basename "$path")"
    cat "$path"
  fi
done
echo "=== containers ==="
docker ps -a --filter name=cathsim --format \
  'table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}'
echo "=== production inspect ==="
docker inspect cathsim-production \
  --format 'image={{.Config.Image}} status={{.State.Status}} health={{if .State.Health}}{{.State.Health.Status}}{{end}}' \
  2>/dev/null || true
echo "=== candidate logs ==="
docker logs --tail 300 cathsim-candidate 2>&1 || true
echo "=== production logs ==="
docker logs --tail 300 cathsim-production 2>&1 || true
echo "=== GPU ==="
nvidia-smi --query-gpu=name,driver_version,memory.total,memory.used \
  --format=csv,noheader 2>/dev/null || true
echo "=== health ==="
curl --silent --show-error --max-time 5 \
  http://127.0.0.1:9000/api/v1/health || true
echo
