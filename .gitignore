# Godot Android project sources are versioned; local Gradle outputs are not.
# The explicit build-directory exceptions override the generic build/ rule
# above so a future custom Gradle template can be committed safely.
!godot_client/android/
!godot_client/android/build/
!godot_client/android/build/**
godot_client/android/build/.gradle/
godot_client/android/build/build/
godot_client/android/build/.cxx/
godot_client/android/build/local.properties

# Android build outputs and local signing material.
.gradle/
.cxx/
*.apk
*.aab
*.idsig
*.keystore
*.jks
local.properties
